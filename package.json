    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^20.14.6",
    "jsqr": "^1.4.0",
    "oxlint": "^1.87.0",
    "typescript": "~7.0.2",
